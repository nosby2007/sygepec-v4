// Add inside service firebase.storage / match /b/{bucket}/o.
function taxProfile() {
  return firestore.get(/databases/(default)/documents/taxUsers/$(request.auth.uid)).data;
}

function taxPreparer() {
  return request.auth != null
    && firestore.exists(/databases/(default)/documents/taxUsers/$(request.auth.uid))
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().role == 'PREPARER';
}

function validTaxReturn(clientUid, returnId) {
  return firestore.exists(/databases/(default)/documents/taxReturns/$(returnId))
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.tenantId == 'perry-tax-pro'
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.clientId == clientUid;
}

function businessEntry(entryId) {
  return firestore.get(/databases/(default)/documents/taxBusinessEntries/$(entryId)).data;
}

match /tax/perry-tax-pro/{clientUid}/{returnId}/{documentId}/{fileName} {
  allow read: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxPreparer());
  allow create: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxPreparer())
    && request.resource.size > 0
    && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp|image/heic)');
  allow update: if false;
  // Matches the Firestore taxDocuments rule: clients cannot remove files from a filed return.
  allow delete: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (
      taxPreparer()
      || (request.auth.uid == clientUid
        && !(firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.status in ['FILED', 'ACCEPTED']))
    );
}

match /tax/perry-tax-pro/business/{clientUid}/{entryId}/{receiptFile} {
 allow read: if request.auth != null && (request.auth.uid == clientUid || taxPreparer());
 allow create: if request.auth != null && request.auth.uid == clientUid
  && businessEntry(entryId).tenantId == 'perry-tax-pro'
  && businessEntry(entryId).clientId == clientUid
  && businessEntry(entryId).kind == 'expense'
  && request.resource.size > 0 && request.resource.size <= 10485760
  && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
 allow update, delete: if false;
}

// Public business images (logo, cover, service photos). Anyone may read them; only the
// business account itself may upload, images only, 2 MB at most.
match /biz/{businessId}/public/{fileName} {
  allow read: if true;
  allow create: if request.auth != null
    && request.auth.uid == businessId
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().accountType == 'BUSINESS'
    && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|webp)')
    && request.resource.size > 0
    && request.resource.size <= 2 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
  allow update: if false;
  allow delete: if request.auth != null && request.auth.uid == businessId;
}
