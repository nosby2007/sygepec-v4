// Add inside service firebase.storage / match /b/{bucket}/o.
function taxProfile() {
  return firestore.get(/databases/(default)/documents/taxUsers/$(request.auth.uid)).data;
}

function taxPreparer() {
  return request.auth != null
    && firestore.exists(/databases/(default)/documents/taxUsers/$(request.auth.uid))
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().role == 'PREPARER';
}

function taxClient() {
  return request.auth != null
    && firestore.exists(/databases/(default)/documents/taxUsers/$(request.auth.uid))
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().role == 'CLIENT';
}

function validTaxReturn(clientUid, returnId) {
  return firestore.exists(/databases/(default)/documents/taxReturns/$(returnId))
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.tenantId == 'perry-tax-pro'
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.clientId == clientUid;
}

match /tax/perry-tax-pro/{clientUid}/{returnId}/{documentId}/{fileName} {
  allow read: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxPreparer());
  allow create: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxPreparer())
    && request.resource.size > 0
    && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp|image/heic)');
  allow update: if false;
  allow delete: if request.auth != null
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxPreparer());
}

match /tax/perry-tax-pro/business/{clientUid}/{entryId}/{receiptFile} {
 allow read: if request.auth != null && (request.auth.uid == clientUid || taxPreparer());
 allow create: if taxClient() && request.auth.uid == clientUid
  && firestore.exists(/databases/(default)/documents/taxBusinessEntries/$(entryId))
  && firestore.get(/databases/(default)/documents/taxBusinessEntries/$(entryId)).data.clientId == clientUid
  && firestore.get(/databases/(default)/documents/taxBusinessEntries/$(entryId)).data.kind == 'expense'
  && request.resource.size > 0 && request.resource.size <= 10485760
  && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
 allow update, delete: if false;
}
