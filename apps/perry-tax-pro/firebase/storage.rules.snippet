// Add inside service firebase.storage / match /b/{bucket}/o.
//
// Storage rules may read at most TWO Firestore documents per request. So everything these
// rules need about the caller is on their own taxUsers/{uid} record, written only by the
// server: role and tenant, `blocked` (mirrors taxAccountBlocks), `platformAdmin` (mirrors a
// PLATFORM_ADMIN support role) and `fileGrants` ({clientUid: expiry in ms}, mirrors the
// reasons given in client files). A return-file request reads that record and the return:
// two documents, whoever asks.

function taxProfile() {
  return firestore.get(/databases/(default)/documents/taxUsers/$(request.auth.uid)).data;
}

// Signed in and not blocked: a block closes direct Storage access with the account's own
// token too (the Firebase account itself stays enabled).
function taxActive() {
  return request.auth != null
    && (!firestore.exists(/databases/(default)/documents/taxUsers/$(request.auth.uid))
      || taxProfile().get('blocked', false) != true);
}

function taxPreparer() {
  return taxActive()
    && firestore.exists(/databases/(default)/documents/taxUsers/$(request.auth.uid))
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().role == 'PREPARER';
}

// The general admin (a preparer holding PLATFORM_ADMIN), from the mirrored flag.
function taxGeneralAdmin() {
  return taxPreparer() && taxProfile().get('platformAdmin', false) == true;
}

// A reason given in the client file opens that client's documents to that preparer for 30
// minutes.
function taxFreshGrant(clientUid) {
  return request.time.toMillis() < taxProfile().get('fileGrants', {}).get(clientUid, 0);
}

function validTaxReturn(clientUid, returnId) {
  return firestore.exists(/databases/(default)/documents/taxReturns/$(returnId))
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.tenantId == 'perry-tax-pro'
    && firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.clientId == clientUid;
}

function taxReturnDoc(returnId) {
  return firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data;
}

// The same people the app lets in: the assigned preparer or the general admin change a
// return's files; opening one also works with a fresh reason.
function taxReturnEditor(returnId) {
  return taxPreparer() && (taxReturnDoc(returnId).get('preparerId', null) == request.auth.uid || taxGeneralAdmin());
}

function taxReturnReader(clientUid, returnId) {
  return taxPreparer()
    && (taxReturnDoc(returnId).get('preparerId', null) == request.auth.uid || taxGeneralAdmin() || taxFreshGrant(clientUid));
}

function businessEntry(entryId) {
  return firestore.get(/databases/(default)/documents/taxBusinessEntries/$(entryId)).data;
}

function taxSupportAttachment(attachmentId) {
  return firestore.get(/databases/(default)/documents/taxSupportAttachments/$(attachmentId)).data;
}

// Two documents per branch: the attachment and the client's own record, or the attachment
// and the staff member's support role. The client's record is read last, only once every
// other client condition holds.
function taxSupportCanRead(a) {
  return (a.visibility == 'EXTERNAL' && a.customerUid == request.auth.uid && (a.state == 'AVAILABLE' || a.uploadedBy == request.auth.uid) && taxActive())
    || (firestore.exists(/databases/(default)/documents/taxSupportRoles/$(request.auth.uid))
      && firestore.get(/databases/(default)/documents/taxSupportRoles/$(request.auth.uid)).data.tenantId == 'perry-tax-pro'
      && (a.state == 'AVAILABLE'
        || firestore.get(/databases/(default)/documents/taxSupportRoles/$(request.auth.uid)).data.role in ['SUPPORT_SUPERVISOR', 'PLATFORM_ADMIN']));
}

// Ticket attachments. The server writes the record after its checks, and these rules hold to
// it: no file without a record, the record decides who reads, and quarantine applies here too.
match /taxsupport/perry-tax-pro/{ticketId}/{visibility}/{attachmentId}/{fileName} {
  allow read: if request.auth != null
    && taxSupportAttachment(attachmentId).storagePath == 'taxsupport/perry-tax-pro/' + ticketId + '/' + visibility + '/' + attachmentId + '/' + fileName
    && taxSupportCanRead(taxSupportAttachment(attachmentId));
  allow create: if request.auth != null
    && taxSupportAttachment(attachmentId).state == 'UPLOADING'
    && taxSupportAttachment(attachmentId).uploadedBy == request.auth.uid
    && taxSupportAttachment(attachmentId).storagePath == 'taxsupport/perry-tax-pro/' + ticketId + '/' + visibility + '/' + attachmentId + '/' + fileName
    && request.resource.size == taxSupportAttachment(attachmentId).size
    && request.resource.contentType == taxSupportAttachment(attachmentId).mime
    && taxActive();
  allow update, delete: if false;
}

match /tax/perry-tax-pro/{clientUid}/{returnId}/{documentId}/{fileName} {
  allow read: if taxActive()
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxReturnReader(clientUid, returnId));
  allow create: if taxActive()
    && validTaxReturn(clientUid, returnId)
    && (request.auth.uid == clientUid || taxReturnEditor(returnId))
    && request.resource.size > 0
    && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp|image/heic)');
  allow update: if false;
  // Matches the Firestore taxDocuments rule: clients cannot remove files from a filed return.
  // Signed Form 8879 files (signed-*.pdf) are kept for the IRS retention period.
  allow delete: if taxActive()
    && !fileName.matches('signed-.*')
    && validTaxReturn(clientUid, returnId)
    && (
      taxReturnEditor(returnId)
      || (request.auth.uid == clientUid
        && !(firestore.get(/databases/(default)/documents/taxReturns/$(returnId)).data.status in ['FILED', 'ACCEPTED']))
    );
}

match /tax/perry-tax-pro/business/{clientUid}/{entryId}/{receiptFile} {
 allow read: if taxActive() && (request.auth.uid == clientUid || taxPreparer());
 allow create: if taxActive() && request.auth.uid == clientUid
  && businessEntry(entryId).tenantId == 'perry-tax-pro'
  && businessEntry(entryId).clientId == clientUid
  && businessEntry(entryId).kind == 'expense'
  && request.resource.size > 0 && request.resource.size <= 10485760
  && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
 allow update, delete: if false;
}

// Public business images (logo, cover, service photos). Anyone may read them; only the
// business account itself may upload, images only, 2 MB at most.
match /biz/{businessId}/public/{fileName} {
  allow read: if true;
  allow create: if taxActive()
    && request.auth.uid == businessId
    && taxProfile().tenantId == 'perry-tax-pro'
    && taxProfile().accountType == 'BUSINESS'
    && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|webp)')
    && request.resource.size > 0
    && request.resource.size <= 2 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
  allow update: if false;
  allow delete: if taxActive() && request.auth.uid == businessId;
}

// Images for the public site (services, posts, team). Readable by anyone; only
// preparers upload, images only, 2 MB at most.
match /cms/public/{fileName} {
  allow read: if true;
  allow create: if taxPreparer()
    && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|webp)')
    && request.resource.size > 0
    && request.resource.size <= 2 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
  allow update: if false;
  allow delete: if taxPreparer();
}
