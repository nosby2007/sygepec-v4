// Add inside service cloud.firestore / databases/{database}/documents.
// This block is intentionally isolated from the existing SYGEPEC collections.
function taxSignedIn() {
  return request.auth != null;
}

function taxUser() {
  return get(/databases/$(database)/documents/taxUsers/$(request.auth.uid)).data;
}

function taxPreparer() {
  return taxSignedIn()
    && exists(/databases/$(database)/documents/taxUsers/$(request.auth.uid))
    && taxUser().tenantId == 'perry-tax-pro'
    && taxUser().role == 'PREPARER';
}

function taxClientAccount() {
  return taxSignedIn()
    && existsAfter(/databases/$(database)/documents/taxUsers/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/taxUsers/$(request.auth.uid)).data.role == 'CLIENT'
    && (
      !getAfter(/databases/$(database)/documents/taxUsers/$(request.auth.uid)).data.keys().hasAny(['accountType'])
      || getAfter(/databases/$(database)/documents/taxUsers/$(request.auth.uid)).data.accountType == 'TAX'
    );
}

function taxReturn(returnId) {
  return get(/databases/$(database)/documents/taxReturns/$(returnId)).data;
}

function canAccessTaxReturn(returnId) {
  return taxSignedIn()
    && exists(/databases/$(database)/documents/taxReturns/$(returnId))
    && taxReturn(returnId).tenantId == 'perry-tax-pro'
    && (taxReturn(returnId).clientId == request.auth.uid || taxPreparer());
}

match /taxUsers/{uid} {
  allow get: if taxSignedIn() && (uid == request.auth.uid || taxPreparer());
  allow list: if taxPreparer();
  allow create: if taxSignedIn()
    && uid == request.auth.uid
    && request.resource.data.keys().hasOnly([
      'uid', 'name', 'email', 'phone', 'role', 'accountType', 'tenantId', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.role == 'CLIENT'
    && request.resource.data.accountType in ['TAX', 'BUSINESS']
    && request.resource.data.tenantId == 'perry-tax-pro';
  allow update: if taxSignedIn()
    && uid == request.auth.uid
    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'phone', 'updatedAt'])
    && request.resource.data.role == resource.data.role
    && request.resource.data.tenantId == resource.data.tenantId;
  allow delete: if false;
}

match /taxReturns/{returnId} {
  allow get, list: if taxSignedIn()
    && resource.data.tenantId == 'perry-tax-pro'
    && (resource.data.clientId == request.auth.uid || taxPreparer());
  // Clients can reach Firestore directly with their own ID token, so a new return
  // must start with every preparer-controlled workflow field at its initial value.
  allow create: if taxSignedIn()
    && taxClientAccount()
    && request.resource.data.keys().hasOnly([
      'tenantId', 'clientId', 'clientName', 'clientEmail', 'clientPhone', 'preparerId', 'preparerName',
      'signatureStatus', 'signatureMethod', 'signatureRequestedAt', 'signedAt',
      'submissionStatus', 'submissionReference', 'submissionNotes', 'submittedAt', 'acceptedAt',
      'carryForwardFromReturnId', 'carryForwardFromTaxYear',
      'taxYear', 'status', 'filingStatus', 'intake', 'docCount', 'createdAt', 'updatedAt'
    ])
    && returnId == request.auth.uid + '_' + string(request.resource.data.taxYear)
    && request.resource.data.clientId == request.auth.uid
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.status == 'INTAKE'
    && request.resource.data.preparerId == null
    && request.resource.data.get('preparerName', null) == null
    && request.resource.data.get('signatureStatus', 'NOT_REQUESTED') == 'NOT_REQUESTED'
    && request.resource.data.get('signedAt', null) == null
    && request.resource.data.get('submissionStatus', 'NOT_READY') == 'NOT_READY'
    && request.resource.data.get('submittedAt', null) == null
    && request.resource.data.get('acceptedAt', null) == null
    && request.resource.data.get('docCount', 0) == 0
    && request.resource.data.taxYear is int
    && request.resource.data.taxYear >= 2020
    && request.resource.data.taxYear <= 2100;
  allow update: if taxSignedIn()
    && resource.data.tenantId == 'perry-tax-pro'
    && (
      (taxPreparer()
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.taxYear == resource.data.taxYear
        && request.resource.data.createdAt == resource.data.createdAt)
      || (request.auth.uid == resource.data.clientId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['docCount'])
        && (request.resource.data.docCount == resource.data.docCount + 1
          || (request.resource.data.docCount == resource.data.docCount - 1
            && request.resource.data.docCount >= 0
            && !(resource.data.status in ['FILED', 'ACCEPTED']))))
      || (
        resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.taxYear == resource.data.taxYear
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'intake', 'filingStatus', 'status', 'updatedAt'
        ])
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'INTAKE' && request.resource.data.status == 'DOCS_PENDING')
        )
        // Answers are frozen once Form 8879 is out for signature or the return is filed.
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['intake', 'filingStatus'])
          || resource.data.status in ['INTAKE', 'DOCS_PENDING', 'IN_REVIEW']
        )
      )
    );
  allow delete: if false;
}

match /taxDocuments/{docId} {
  allow get, list: if canAccessTaxReturn(resource.data.returnId);
  allow create: if canAccessTaxReturn(request.resource.data.returnId)
    && request.resource.data.keys().hasOnly([
      'tenantId', 'returnId', 'clientId', 'type', 'filename', 'storagePath', 'mime', 'size', 'uploadedBy', 'createdAt'
    ])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.clientId == taxReturn(request.resource.data.returnId).clientId
    && request.resource.data.uploadedBy == request.auth.uid
    // The record may only point at this return's own Storage folder.
    && request.resource.data.storagePath is string
    && request.resource.data.storagePath.matches(
      'tax/perry-tax-pro/' + request.resource.data.clientId + '/' + request.resource.data.returnId + '/' + docId + '/[^/]+'
    );
  allow update: if false;
  allow delete: if canAccessTaxReturn(resource.data.returnId)
    && (
      taxPreparer()
      || (
        resource.data.clientId == request.auth.uid
        && !['FILED', 'ACCEPTED'].hasAny([taxReturn(resource.data.returnId).status])
      )
    );
}

match /taxNotes/{noteId} {
  allow get, list: if canAccessTaxReturn(resource.data.returnId);
  allow create: if canAccessTaxReturn(request.resource.data.returnId)
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.clientId == taxReturn(request.resource.data.returnId).clientId
    && request.resource.data.keys().hasOnly([
      'tenantId', 'returnId', 'clientId', 'authorId', 'authorName', 'authorRole', 'message', 'createdAt'
    ])
    && request.resource.data.authorId == request.auth.uid
    && request.resource.data.authorRole == taxUser().role
    && request.resource.data.authorName == taxUser().name
    && request.resource.data.message is string
    && request.resource.data.message.size() > 0
    && request.resource.data.message.size() <= 4000;
  allow update, delete: if false;
}

// ---- Tax appointments: availability booking, slot locks, history, settings ----

function taxMember() {
  return taxSignedIn()
    && exists(/databases/$(database)/documents/taxUsers/$(request.auth.uid))
    && taxUser().tenantId == 'perry-tax-pro';
}

function bookingRule(field, fallback) {
  return exists(/databases/$(database)/documents/taxSettings/booking)
    ? get(/databases/$(database)/documents/taxSettings/booking).data.get(field, fallback)
    : fallback;
}

function taxAppointment(appointmentId) {
  return /databases/$(database)/documents/taxAppointments/$(appointmentId);
}

// Mirrors clientCanChange(): clients act on their own only before the cut-off.
function clientChangeWindowOpen() {
  return resource.data.get('startMs', 0) - request.time.toMillis() > bookingRule('cancelCutoffHours', 24) * 3600000;
}

// Meeting links are https Zoom URLs only, so nothing else can be presented as the meeting.
function validMeetingUrl(data) {
  return data.get('meetingUrl', null) == null
    || (data.meetingUrl is string
      && data.meetingUrl.size() <= 500
      && data.meetingUrl.matches('https://([A-Za-z0-9-]+[.])*(zoom[.]us|zoomgov[.]com)(/[^ ]*)?'));
}

match /taxAppointments/{appointmentId} {
  allow get, list: if taxSignedIn()
    && resource.data.tenantId == 'perry-tax-pro'
    && (resource.data.clientId == request.auth.uid || taxPreparer());
  allow create: if taxSignedIn()
    && taxClientAccount()
    && request.resource.data.keys().hasOnly([
      'tenantId', 'clientId', 'name', 'email', 'phone', 'scheduledAt', 'startMs', 'durationMinutes', 'timeZone',
      'clientTimeZone', 'type', 'service', 'notes', 'status', 'slotIds', 'rescheduleCount', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.clientId == request.auth.uid
    && request.resource.data.type in ['VIRTUAL', 'IN_PERSON']
    && request.resource.data.status == 'REQUESTED'
    && request.resource.data.startMs is int
    && request.resource.data.startMs > request.time.toMillis()
    && request.resource.data.durationMinutes is int
    && request.resource.data.durationMinutes >= 15
    && request.resource.data.durationMinutes <= 240
    && request.resource.data.slotIds is list
    && request.resource.data.slotIds.size() > 0
    && request.resource.data.slotIds.size() <= 24
    && request.resource.data.rescheduleCount == 0;
  allow update: if taxSignedIn()
    && resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.tenantId == resource.data.tenantId
    && request.resource.data.clientId == resource.data.clientId
    && (
      (taxPreparer()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'confirmedAt', 'scheduledAt', 'startMs', 'durationMinutes', 'timeZone', 'slotIds',
          'cancelledBy', 'cancelReason', 'assigneeId', 'assigneeName', 'meetingUrl', 'meetingInstructions',
          'meetingProvider', 'meetingUpdatedAt', 'zoomMeetingId', 'updatedAt'
        ])
        && request.resource.data.status in ['REQUESTED', 'CONFIRMED', 'COMPLETED', 'CANCELLED']
        && validMeetingUrl(request.resource.data))
      || (resource.data.clientId == request.auth.uid
        && resource.data.status in ['REQUESTED', 'CONFIRMED']
        && clientChangeWindowOpen()
        && (
          // Cancel: releases every slot.
          (request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'slotIds', 'cancelledBy', 'cancelReason', 'updatedAt'])
            && request.resource.data.status == 'CANCELLED'
            && request.resource.data.slotIds.size() == 0
            && request.resource.data.cancelledBy == 'CLIENT')
          // Reschedule: goes back to the preparer for confirmation, a limited number of times.
          || (request.resource.data.diff(resource.data).changedKeys().hasOnly(['scheduledAt', 'startMs', 'timeZone', 'slotIds', 'status', 'rescheduleCount', 'updatedAt'])
            && request.resource.data.status == 'REQUESTED'
            && request.resource.data.startMs is int
            && request.resource.data.startMs > request.time.toMillis()
            && request.resource.data.slotIds.size() > 0
            && request.resource.data.slotIds.size() <= 24
            && request.resource.data.rescheduleCount == resource.data.get('rescheduleCount', 0) + 1
            && request.resource.data.rescheduleCount <= bookingRule('maxReschedules', 3))
        ))
    );
  allow delete: if false;
}

// One document per occupied grid cell and seat, created in the same commit as the
// appointment with "must not exist" preconditions; that is what prevents double booking.
// They hold no client data, so any portal member may read them to see busy times.
match /taxAppointmentSlots/{slotId} {
  allow get, list: if taxMember();
  allow create: if taxSignedIn()
    && request.resource.data.keys().hasOnly(['tenantId', 'appointmentId', 'cell', 'seat', 'createdAt'])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.cell is string
    && request.resource.data.cell.matches('[0-9]{8}T[0-9]{4}Z')
    && request.resource.data.seat is int
    && request.resource.data.seat >= 1
    && request.resource.data.seat <= 10
    && slotId == request.resource.data.cell + '_s' + string(request.resource.data.seat)
    && existsAfter(taxAppointment(request.resource.data.appointmentId))
    && getAfter(taxAppointment(request.resource.data.appointmentId)).data.slotIds.hasAny([slotId])
    && (taxPreparer() || getAfter(taxAppointment(request.resource.data.appointmentId)).data.clientId == request.auth.uid);
  allow update: if false;
  // A client may release only slots their own appointment no longer holds.
  allow delete: if taxSignedIn()
    && (taxPreparer()
      || (get(taxAppointment(resource.data.appointmentId)).data.clientId == request.auth.uid
        && !getAfter(taxAppointment(resource.data.appointmentId)).data.slotIds.hasAny([slotId])));
}

// Append-only appointment history. Entries marked internal are for staff only.
match /taxAppointmentEvents/{eventId} {
  allow get, list: if taxSignedIn()
    && resource.data.tenantId == 'perry-tax-pro'
    && (taxPreparer() || (resource.data.clientId == request.auth.uid && resource.data.visibility == 'client'));
  allow create: if taxSignedIn()
    && request.resource.data.keys().hasOnly([
      'tenantId', 'appointmentId', 'clientId', 'actorId', 'actorName', 'actorRole', 'action', 'detail', 'visibility', 'channel', 'createdAt'
    ])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.actorId == request.auth.uid
    && request.resource.data.actorRole == taxUser().role
    && request.resource.data.actorName == taxUser().name
    && request.resource.data.detail is string
    && request.resource.data.detail.size() <= 500
    && existsAfter(taxAppointment(request.resource.data.appointmentId))
    && getAfter(taxAppointment(request.resource.data.appointmentId)).data.clientId == request.resource.data.clientId
    && (
      (taxPreparer()
        && request.resource.data.visibility in ['client', 'internal']
        && request.resource.data.action in ['CONFIRMED', 'COMPLETED', 'CANCELLED', 'RESCHEDULED', 'ASSIGNED', 'MEETING_UPDATED', 'MEETING_SHARED', 'NOTE'])
      || (request.resource.data.clientId == request.auth.uid
        && request.resource.data.visibility == 'client'
        && request.resource.data.action in ['BOOKED', 'CANCELLED', 'RESCHEDULED'])
    );
  allow update, delete: if false;
}

match /taxSettings/{settingId} {
  allow get: if taxMember();
  allow list: if false;
  allow create, update: if taxPreparer()
    && settingId == 'booking'
    && request.resource.data.keys().hasOnly([
      'tenantId', 'timeZone', 'slotMinutes', 'bufferMinutes', 'minNoticeHours', 'horizonDays', 'capacity',
      'cancelCutoffHours', 'maxReschedules', 'weekly', 'services', 'closedDates', 'updatedAt', 'updatedBy', 'updatedByName'
    ])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.timeZone is string
    && request.resource.data.timeZone.size() <= 64
    && request.resource.data.slotMinutes in [15, 30, 60]
    && request.resource.data.bufferMinutes is int && request.resource.data.bufferMinutes >= 0 && request.resource.data.bufferMinutes <= 120
    && request.resource.data.minNoticeHours is int && request.resource.data.minNoticeHours >= 0 && request.resource.data.minNoticeHours <= 336
    && request.resource.data.horizonDays is int && request.resource.data.horizonDays >= 1 && request.resource.data.horizonDays <= 180
    && request.resource.data.capacity is int && request.resource.data.capacity >= 1 && request.resource.data.capacity <= 10
    && request.resource.data.cancelCutoffHours is int && request.resource.data.cancelCutoffHours >= 0 && request.resource.data.cancelCutoffHours <= 336
    && request.resource.data.maxReschedules is int && request.resource.data.maxReschedules >= 0 && request.resource.data.maxReschedules <= 10
    && request.resource.data.weekly is map
    && request.resource.data.services is list && request.resource.data.services.size() <= 20
    && request.resource.data.closedDates is list && request.resource.data.closedDates.size() <= 200;
  allow delete: if false;
}


// Business workspace: client-owned, tenant-isolated immutable records.
// These rules must be integrated and emulator-tested before production.
function businessOwner() {
 return taxSignedIn()
  && exists(/databases/$(database)/documents/taxUsers/$(request.auth.uid))
  && taxUser().tenantId == 'perry-tax-pro'
  && taxUser().role == 'CLIENT'
  && taxUser().accountType == 'BUSINESS';
}

match /taxBusinessEntries/{entryId} {
  allow get, list: if businessOwner()
    && resource.data.tenantId == 'perry-tax-pro'
    && resource.data.clientId == request.auth.uid;
  allow create: if businessOwner()
    && request.resource.data.keys().hasOnly([
      'tenantId','clientId','taxYear','kind','category','amountCents','date','description','createdAt'
    ])
    && request.resource.data.tenantId == 'perry-tax-pro'
    && request.resource.data.clientId == request.auth.uid
    && request.resource.data.taxYear is int
    && request.resource.data.taxYear >= 2020
    && request.resource.data.taxYear <= 2100
    && request.resource.data.kind in ['income','expense']
    && request.resource.data.category is string
    && (
      (request.resource.data.kind == 'income'
        && request.resource.data.category in ['Sales','Services','Other income'])
      || (request.resource.data.kind == 'expense'
        && request.resource.data.category in [
          'Advertising','Car and truck','Contract labor','Insurance','Office expenses',
          'Rent','Repairs','Supplies','Taxes and licenses','Travel','Meals','Utilities','Other expense'
        ])
    )
    && request.resource.data.amountCents is int
    && request.resource.data.amountCents > 0
    && request.resource.data.amountCents <= 99999999999
    && request.resource.data.date is string
    && request.resource.data.date.size() == 10
    && request.resource.data.description is string
    && request.resource.data.description.size() <= 300;
  allow update, delete: if false;
}

match /taxBusinessCustomers/{customerId} {
 allow get, list: if businessOwner()
   && resource.data.tenantId == 'perry-tax-pro'
   && resource.data.ownerUid == request.auth.uid;
 allow create: if businessOwner()
   && request.resource.data.keys().hasOnly(['tenantId','ownerUid','name','phone','email','notes','createdAt'])
   && request.resource.data.tenantId == 'perry-tax-pro'
   && request.resource.data.ownerUid == request.auth.uid
   && request.resource.data.name is string
   && request.resource.data.name.size() > 0
   && request.resource.data.name.size() <= 100
   && request.resource.data.phone is string
   && request.resource.data.phone.size() <= 30
   && request.resource.data.email is string
   && request.resource.data.email.size() <= 254
   && request.resource.data.notes is string
   && request.resource.data.notes.size() <= 500;
 allow update, delete: if false;
}

match /taxBusinessServices/{id} {
 allow get, list: if businessOwner() && resource.data.tenantId == 'perry-tax-pro' && resource.data.ownerUid == request.auth.uid;
 allow create: if businessOwner()
  && request.resource.data.keys().hasOnly(['tenantId','ownerUid','name','priceCents','durationMinutes','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.ownerUid == request.auth.uid
  && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
  && request.resource.data.priceCents is int && request.resource.data.priceCents > 0 && request.resource.data.priceCents <= 99999999999
  && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes >= 15 && request.resource.data.durationMinutes <= 480;
 allow update, delete: if false;
}
match /taxBusinessBookings/{id} {
 allow get, list: if businessOwner() && resource.data.tenantId == 'perry-tax-pro' && resource.data.ownerUid == request.auth.uid;
 allow create: if businessOwner()
  && request.resource.data.keys().hasOnly(['tenantId','ownerUid','customerId','customerName','serviceId','serviceName','start','durationMinutes','priceCents','status','reminderStatus','notes','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.ownerUid == request.auth.uid
  && request.resource.data.status == 'SCHEDULED' && request.resource.data.reminderStatus == 'NOT_SENT'
  && request.resource.data.start is string && request.resource.data.start.size() == 16
  && request.resource.data.customerId is string && request.resource.data.serviceId is string
  && request.resource.data.customerName is string && request.resource.data.serviceName is string
  && request.resource.data.durationMinutes is int && request.resource.data.priceCents is int
  && request.resource.data.notes is string && request.resource.data.notes.size() <= 300
  && exists(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId))
  && get(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId)).data.ownerUid == request.auth.uid
  && request.resource.data.customerName == get(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId)).data.name
  && exists(/databases/$(database)/documents/taxBusinessServices/$(request.resource.data.serviceId))
  && get(/databases/$(database)/documents/taxBusinessServices/$(request.resource.data.serviceId)).data.ownerUid == request.auth.uid
  && request.resource.data.serviceName == get(/databases/$(database)/documents/taxBusinessServices/$(request.resource.data.serviceId)).data.name
  && request.resource.data.durationMinutes == get(/databases/$(database)/documents/taxBusinessServices/$(request.resource.data.serviceId)).data.durationMinutes
  && request.resource.data.priceCents == get(/databases/$(database)/documents/taxBusinessServices/$(request.resource.data.serviceId)).data.priceCents;
 allow update, delete: if false;
}
match /taxBusinessInvoices/{id} {
 allow get, list: if businessOwner() && resource.data.tenantId == 'perry-tax-pro' && resource.data.ownerUid == request.auth.uid;
 allow create: if businessOwner()
  && request.resource.data.keys().hasOnly(['tenantId','ownerUid','customerId','customerName','description','amountCents','dueDate','status','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.ownerUid == request.auth.uid
  && request.resource.data.status == 'DRAFT'
  && request.resource.data.customerId is string
  && exists(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId))
  && get(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId)).data.ownerUid == request.auth.uid
  && request.resource.data.customerName == get(/databases/$(database)/documents/taxBusinessCustomers/$(request.resource.data.customerId)).data.name
  && request.resource.data.description is string
  && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 200
  && request.resource.data.amountCents is int && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 99999999999
  && request.resource.data.dueDate is string && request.resource.data.dueDate.size() == 10;
 allow update, delete: if false;
}

match /taxBusinessCorrections/{id} {
 allow get, list: if taxSignedIn() && resource.data.tenantId == 'perry-tax-pro' && (resource.data.clientId == request.auth.uid || taxPreparer());
 allow create: if businessOwner() && request.resource.data.keys().hasOnly(['tenantId','clientId','entryId','taxYear','originalKind','originalCategory','originalAmountCents','kind','category','amountCents','reason','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.clientId == request.auth.uid
  && exists(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId))
  && get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.clientId == request.auth.uid
  && request.resource.data.taxYear == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.taxYear
  && request.resource.data.originalKind == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.kind
  && request.resource.data.originalCategory == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.category
  && request.resource.data.originalAmountCents == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.amountCents
  && request.resource.data.amountCents is int && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 99999999999
  && request.resource.data.kind in ['income','expense']
  && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 60
  && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 500;
 allow update, delete: if false;
}
match /taxBusinessMatches/{id} {
 allow get, list: if taxSignedIn() && resource.data.tenantId == 'perry-tax-pro' && (resource.data.clientId == request.auth.uid || taxPreparer());
 allow create: if businessOwner() && request.resource.data.keys().hasOnly(['tenantId','clientId','entryId','taxYear','bankReference','statementDate','amountCents','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.clientId == request.auth.uid
  && exists(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId))
  && get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.clientId == request.auth.uid
  && request.resource.data.taxYear == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.taxYear
  && request.resource.data.amountCents == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.amountCents
  && request.resource.data.bankReference is string && request.resource.data.bankReference.size() > 0 && request.resource.data.bankReference.size() <= 100
  && request.resource.data.statementDate is string && request.resource.data.statementDate.size() == 10;
 allow update, delete: if false;
}
match /taxBusinessReceipts/{id} {
 allow get, list: if taxSignedIn() && resource.data.tenantId == 'perry-tax-pro' && (resource.data.clientId == request.auth.uid || taxPreparer());
 allow create: if businessOwner() && request.resource.data.keys().hasOnly(['tenantId','clientId','entryId','taxYear','storagePath','mime','size','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.clientId == request.auth.uid
  && exists(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId))
  && get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.clientId == request.auth.uid
  && request.resource.data.taxYear == get(/databases/$(database)/documents/taxBusinessEntries/$(request.resource.data.entryId)).data.taxYear
  && request.resource.data.storagePath is string
  && request.resource.data.storagePath.matches('tax/perry-tax-pro/business/' + request.auth.uid + '/.*')
  && request.resource.data.mime in ['application/pdf','image/jpeg','image/png']
  && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10485760;
 allow update, delete: if false;
}
match /taxBusinessYearEnd/{id} {
 allow get, list: if taxSignedIn() && resource.data.tenantId == 'perry-tax-pro' && (resource.data.clientId == request.auth.uid || taxPreparer());
 allow create: if businessOwner() && request.resource.data.keys().hasOnly(['tenantId','clientId','taxYear','status','report','createdAt'])
  && request.resource.data.tenantId == 'perry-tax-pro' && request.resource.data.clientId == request.auth.uid
  && request.resource.data.taxYear is int && request.resource.data.taxYear >= 2020 && request.resource.data.taxYear <= 2100
  && request.resource.data.status == 'SUBMITTED_FOR_REVIEW'
  && request.resource.data.report is map;
 allow update, delete: if false;
}
